/Screenshot_*
/*.jpeg
/*.jpg
/*.png

# Vendored Stripe SDK (already tracked; rule kept for reference)
plugins/enaizi-mfa/includes/stripe-php/

# Runtime logs inside plugin folders - these hold real WhatsApp webhook
# payloads (phone numbers, message bodies), not code.
wa-log.txt
wa-error.txt

# Word lock files - created whenever a .docx in this repo is open,
# and never worth committing.
~$*.docx
